# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection (change YOURPASSWORD to your postgres password)
DATABASE_URL=postgresql://postgres:YOURPASSWORD@127.0.0.1:5432/wealthwise

# MongoDB (optional – used later for the vault, imports and news)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=wealthwise

# Session signing secret – at least 32 random characters
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
